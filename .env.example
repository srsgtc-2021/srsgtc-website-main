# Build-time Supabase access (prerendering reads the CMS at build time).
VITE_SUPABASE_URL=https://cylduoaiydgashflgjjk.supabase.co
# Publishable (anon) key - safe for the browser. Never commit the service_role/secret key.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Runtime-only rebuild check (set these in Vercel, never prefix with VITE_).
# Secret expected in the Authorization header from Vercel Cron or the Supabase webhook.
CRON_SECRET=your-long-random-secret
# Vercel Deploy Hook URL for the production deployment.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id
# Optional. Defaults to https://srsgeotech-zeta.vercel.app in the rebuild function.
SITE_URL=https://srsgeotech-zeta.vercel.app
